# Private preview spreadsheet. Never put credentials in NEXT_PUBLIC_ variables.
RADAR_SHEET_ID=your_private_preview_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"radar@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Only for a separate preview protected by Vercel Authentication. Never set in Production.
RADAR_PREVIEW_SSO=0

# Required for CRM unless the protected-preview mode above is explicitly enabled.
RADAR_ADMIN_PASSWORD=replace-with-unique-long-password
RADAR_ADMIN_SECRET=replace-with-32-plus-random-characters

# Alert job remains dry-run unless explicitly enabled after a verified test.
CRON_SECRET=replace-with-24-plus-random-characters
RADAR_EMAIL_ENABLED=0
NEXT_PUBLIC_RADAR_EMAIL_ENABLED=0
# Enable Naver Mail POP3/SMTP and use a dedicated application password, never the login password.
NAVER_SMTP_APP_PASSWORD=
APP_URL=
